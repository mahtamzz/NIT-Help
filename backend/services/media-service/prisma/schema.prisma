generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/media-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  ticketId     String
  messageId    String?
  uploadedById String
  originalName String
  storageKey   String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@index([messageId])
  @@index([uploadedById])
}
