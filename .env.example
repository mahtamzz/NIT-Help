# Environment & Gateway
NODE_ENV=development
GATEWAY_PORT=4000
GATEWAY_INTERNAL_SECRET=nit_help_gateway_internal_secret_2026!

# PostgreSQL (Schema-per-Service)
POSTGRES_BASE_URL=postgresql://postgres:password123@localhost:5432/nit_help
IAM_DATABASE_URL=postgresql://postgres:password123@localhost:5432/nit_help?schema=iam
CORE_DATABASE_URL=postgresql://postgres:password123@localhost:5432/nit_help?schema=core
MEDIA_DATABASE_URL=postgresql://postgres:password123@localhost:5432/nit_help?schema=media
OPS_DATABASE_URL=postgresql://postgres:password123@localhost:5432/nit_help?schema=ops

# RabbitMQ Event Bus
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Microservice HTTP & TCP Ports
IAM_PORT=4001
IAM_TCP_HOST=127.0.0.1
IAM_TCP_PORT=4101

CORE_PORT=4002
CORE_TCP_HOST=127.0.0.1
CORE_TCP_PORT=4102

MEDIA_PORT=4003
MEDIA_TCP_HOST=127.0.0.1
MEDIA_TCP_PORT=4103

OPS_PORT=4004
OPS_TCP_HOST=127.0.0.1
OPS_TCP_PORT=4104

# Security & JWT Secrets
JWT_ACCESS_SECRET=nit_help_jwt_access_super_secret_key_2026_secure!
JWT_REFRESH_SECRET=nit_help_jwt_refresh_super_secret_key_2026_secure!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage (Media Service)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (for CORS and links)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
