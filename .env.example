# Application Port & Environment
PORT=4000
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://postgres:password123@localhost:5432/nit_help?schema=public

# Security & JWT Secrets
JWT_ACCESS_SECRET=nit_help_jwt_access_super_secret_key_2026_secure!
JWT_REFRESH_SECRET=nit_help_jwt_refresh_super_secret_key_2026_secure!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (for CORS and links)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

